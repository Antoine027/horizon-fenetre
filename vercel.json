{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "installCommand": "echo skip",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "regions": [
    "cdg1"
  ],
  "images": {
    "sizes": [
      360,
      400,
      480,
      560,
      640,
      720,
      800,
      900,
      960,
      1200,
      1280,
      1600
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "images.unsplash.com"
      }
    ]
  },
  "headers": [
    {
      "source": "/blog/flux.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "horizon-fenetre.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "horizonfenetre.com"
        }
      ],
      "destination": "https://www.horizonfenetre.com/:path*",
      "permanent": true
    },
    {
      "source": "/nos-menuiseries/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/quisommesnous/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portes-dentree/",
      "destination": "/portes-d-entree/",
      "permanent": true
    },
    {
      "source": "/porte-de-garage/",
      "destination": "/portes-de-garage/",
      "permanent": true
    },
    {
      "source": "/category/:slug*",
      "destination": "https://www.instantterrasse.com/",
      "permanent": true
    },
    {
      "source": "/comment-choisir-sa-terrasse/",
      "destination": "https://www.instantterrasse.com/",
      "permanent": true
    },
    {
      "source": "/comment-nettoyer-une-terrasse-en-bois/",
      "destination": "https://www.instantterrasse.com/",
      "permanent": true
    },
    {
      "source": "/la-terrasse-aluminium/",
      "destination": "https://www.instantterrasse.com/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/controle",
      "schedule": "0 7 1 * *"
    }
  ]
}
